# Node 22.12+ or Node 24. Never put secrets in VITE_* variables.
# Leave VITE_API_BASE_URL blank when frontend and API share the same host.
VITE_API_BASE_URL=
PORT=8787
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8787,http://localhost:8787

# Personal login: set a unique 20–256 character passphrase privately in the host dashboard.
# Do not enable both password and OIDC authentication.
OWNER_PASSWORD=
# Alternative OIDC authentication requires all three fields below.
# Without either mode, development binds ONLY to 127.0.0.1.
OIDC_ISSUER=
OIDC_AUDIENCE=
OWNER_SUB=
# Optional override for providers whose JWKS endpoint differs from Auth0 convention.
OIDC_JWKS_URI=

# Provider credentials; fundamentals may require a separate paid entitlement.
# No provider plan, price or real-time entitlement is guaranteed by this project.
EODHD_API_TOKEN=
TWELVE_DATA_API_KEY=
UPSTOX_ACCESS_TOKEN=

# One server process / one persistent data directory. Keep this directory private.
DATA_DIR=./var/signaldesk
SCANNER_ENABLED=true
SCAN_INTERVAL_MINUTES=60
SCAN_BATCH_SIZE=3
# Optional absolute or relative path to a private JSON universe (maximum 50).
UNIVERSE_FILE=

# User-controlled HTTPS endpoint; receives signed JSON research alerts.
# Configure an endpoint you own; no messages are sent until configured.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Optional mobile notifications through your own Telegram bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set only behind a trusted reverse proxy.
TRUST_PROXY=false

# Browser-safe configuration only. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8787

# Server configuration
PORT=8787
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# OpenID Connect access-token validation
# Example issuer: https://your-tenant.auth0.com/
OIDC_ISSUER=
OIDC_AUDIENCE=

# Set only behind a trusted reverse proxy in production.
TRUST_PROXY=false
